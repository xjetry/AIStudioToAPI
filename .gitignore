.vscode/
.idea/
.cursor/
.DS_Store
.claude/

# Environment variables (keep .env.example)
.env
.env.local
.env.*.local
.env.development
.env.production

# Node.js dependencies
node_modules/
package-lock.json

# Camoufox browser
# Legacy Camoufox bundled binary download locations (upstream v1.2.1 used these).
# camoufox-js now manages its own binary under ~/.cache/camoufox/ and never populates
# these paths, but we keep them ignored in case someone runs the old setup scripts.
camoufox/
camoufox-linux/
camoufox-macos/
camoufox*.zip

# Authentication files
configs/auth/
auth-*.json
users.csv
cache/

# Usage statistics data
data/

# Temporary files
tmp/
temp/
ui/dist/
*.css
test/
debug_*.png
debug_*.html
